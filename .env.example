NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted for Vercel's integration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable only after configuring and testing SMTP delivery in Supabase.
AUTH_EMAIL_ENABLED=false

# Server-only. Used for Slack callbacks, which arrive without a browser session.
SUPABASE_SECRET_KEY=your-secret-key
# Slack app → Basic Information → Signing Secret.
SLACK_SIGNING_SECRET=your-slack-signing-secret
# Resend email capture: API key (reads received emails), webhook signing
# secret (whsec_...), and the receiving domain (e.g. abc123.resend.app).
RESEND_API_KEY=re_your-api-key
RESEND_WEBHOOK_SECRET=whsec_your-webhook-secret
RESEND_INBOUND_DOMAIN=your-id.resend.app
# Organizing agent: encrypts the model API keys users save (32 bytes).
# Generate with: openssl rand -base64 32
AGENT_ENCRYPTION_KEY=your-32-byte-base64-key
# Protects Vercel's scheduled dispatcher (at least 16 random characters).
CRON_SECRET=your-random-cron-secret
# External agent API keys (ADR 007): server-side HMAC pepper for Orbit API
# keys, at least 32 characters. Required to create or accept keys; changing it
# invalidates every issued key. Generate with: openssl rand -base64 32
ORBIT_API_KEY_PEPPER=your-32-plus-character-random-pepper
# Optional: schedule the end of Supabase user-token access to /api/v1 and MCP.
# Unset (default): user tokens stay accepted, with a Deprecation header only.
# Set (YYYY-MM-DD, UTC): responses add a Sunset header, and from that date
# user tokens are refused with 401 credential_type_unsupported.
# ORBIT_USER_TOKEN_SUNSET=2027-01-31
